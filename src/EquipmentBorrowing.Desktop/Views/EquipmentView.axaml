<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView">
  <Grid ColumnDefinitions="*,16,320" RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBlock Text="Equipment records" FontSize="18" FontWeight="SemiBold" Grid.ColumnSpan="3" />
    <views:StatusBarView Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,6" />
    <DockPanel Grid.Row="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <TextBox Width="260" Watermark="Search name, identifier or description" Text="{Binding SearchText}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <Button Content="Search" Command="{Binding SearchCommand}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Identifier" Binding="{Binding EquipmentIdentifier}" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
          <DataGridTextColumn Header="Status" Binding="{Binding AvailabilityText}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
      <TextBlock Text="Details" FontWeight="SemiBold" />
      <TextBlock Text="Equipment identifier" />
      <TextBox Text="{Binding FormIdentifier}" />
      <TextBlock Text="Name" />
      <TextBox Text="{Binding FormName}" />
      <TextBlock Text="Description (optional)" />
      <TextBox Text="{Binding FormDescription}" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
        <Button Content="New" Command="{Binding NewEquipmentCommand}" />
        <Button Content="Register new" Command="{Binding RegisterCommand}" />
        <Button Content="Save changes" Command="{Binding SaveCommand}" />
      </StackPanel>
      <TextBlock Text="Availability changes only through issuing and returning." Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
