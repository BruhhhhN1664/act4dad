<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.HistoryView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBlock Text="Borrowing history" FontSize="18" FontWeight="SemiBold" />
    <views:StatusBarView Grid.Row="1" Margin="0,6,0,6" />
    <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
      <Grid RowDefinitions="Auto,2*,Auto,3*">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBox Width="200" Watermark="Search students" Text="{Binding StudentSearch}">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Content="Search" Command="{Binding SearchCommand}" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" />
            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding StudentHistoryNote}" Margin="0,6" TextWrapping="Wrap" Foreground="Gray" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding StudentHistory}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding EquipmentName}" Width="*" />
            <DataGridTextColumn Header="Borrowed" Binding="{Binding BorrowedText}" />
            <DataGridTextColumn Header="Due" Binding="{Binding ExpectedText}" />
            <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedText}" />
            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,2*,Auto,3*">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBox Width="200" Watermark="Search equipment" Text="{Binding EquipmentSearch}">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Content="Search" Command="{Binding SearchCommand}" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding EquipmentList}" SelectedItem="{Binding SelectedEquipment}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Identifier" Binding="{Binding EquipmentIdentifier}" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding EquipmentHistoryNote}" Margin="0,6" TextWrapping="Wrap" Foreground="Gray" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding EquipmentHistory}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
            <DataGridTextColumn Header="Borrowed" Binding="{Binding BorrowedText}" />
            <DataGridTextColumn Header="Due" Binding="{Binding ExpectedText}" />
            <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedText}" />
            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
