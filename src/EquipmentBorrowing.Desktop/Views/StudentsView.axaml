<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentsView">
  <Grid ColumnDefinitions="*,16,320" RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBlock Text="Student records" FontSize="18" FontWeight="SemiBold" Grid.ColumnSpan="3" />
    <views:StatusBarView Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,6" />
    <DockPanel Grid.Row="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <TextBox Width="260" Watermark="Search name or number" Text="{Binding SearchText}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <Button Content="Search" Command="{Binding SearchCommand}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" />
          <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
          <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="*" />
          <DataGridTextColumn Header="Eligibility" Binding="{Binding EligibilityText}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
      <TextBlock Text="Details" FontWeight="SemiBold" />
      <TextBlock Text="Student number" />
      <TextBox Text="{Binding FormNumber}" />
      <TextBlock Text="Full name" />
      <TextBox Text="{Binding FormName}" />
      <TextBlock Text="Contact (optional)" />
      <TextBox Text="{Binding FormContact}" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
        <Button Content="New" Command="{Binding NewStudentCommand}" />
        <Button Content="Register new" Command="{Binding RegisterCommand}" />
        <Button Content="Save changes" Command="{Binding SaveCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Allow borrowing" Command="{Binding PermitCommand}" />
        <Button Content="Stop borrowing" Command="{Binding RestrictCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
