<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.StatusBarView">
  <StackPanel Spacing="3">
    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
    <TextBlock Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap" IsVisible="{Binding StatusIsError}" />
    <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" TextWrapping="Wrap" IsVisible="{Binding !StatusIsError}" />
    <TextBlock Text="{Binding EmptyMessage}" Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding ShowEmpty}" />
  </StackPanel>
</UserControl>
