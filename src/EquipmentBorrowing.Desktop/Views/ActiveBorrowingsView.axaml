<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.ActiveBorrowingsView">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Active borrowings" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Command="{Binding ReloadCommand}" />
        <Button Content="Return selected item" Command="{Binding ReturnSelectedCommand}" />
      </StackPanel>
      <views:StatusBarView />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Student no." Binding="{Binding StudentNumber}" />
        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
        <DataGridTextColumn Header="Item ID" Binding="{Binding EquipmentIdentifier}" />
        <DataGridTextColumn Header="Item" Binding="{Binding EquipmentName}" Width="*" />
        <DataGridTextColumn Header="Borrowed" Binding="{Binding BorrowedText}" />
        <DataGridTextColumn Header="Due" Binding="{Binding ExpectedText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
