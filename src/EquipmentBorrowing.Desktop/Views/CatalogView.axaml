<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.CatalogView">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Equipment catalog" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="300" Watermark="Search name, identifier or description" Text="{Binding SearchText}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <CheckBox Content="Show only available equipment" IsChecked="{Binding AvailableOnly}" />
        <Button Content="Search" Command="{Binding LoadCommand}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
      </StackPanel>
      <views:StatusBarView />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Identifier" Binding="{Binding EquipmentIdentifier}" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
        <DataGridTextColumn Header="Status" Binding="{Binding AvailabilityText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
